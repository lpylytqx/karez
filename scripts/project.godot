; 《坎儿井》Godot 工程配置
; 用 Godot 4.4+ 打开本文件所在目录即可（scripts/ 就是工程根）。

config_version=5

[application]

config/name="坎儿井"
config/description="AI 原生 2D 丝路经营游戏 —— M1 闭环原型"
run/main_scene="res://scenes/map.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
config/windows_native_icon=""

; 美术与音频素材在工程目录之外（D:\坎儿井\assets\）。
; 已通过 Windows 目录联接（junction）把 assets 下的 tiles/buildings/characters/fx/audio/fonts
; 挂到本工程根（scripts\），ui 素材用文件硬链接挂进 scripts\ui\（保留 ui\main.gd）。
; 所以代码里直接写 res://tiles/...、res://buildings/... 即可访问。
; 若在其他机器上打开本工程，需先重建这些 junction（见 scripts/rebuild_links.ps1）。
; 若日后把 assets/ 移进 scripts/（工程根）内部，删掉 junction 即可。

[display]

; 逻辑分辨率 640x360（40x22 格，16x16 tile），窗口放大 2 倍到 1280x720。
; canvas_items 会把 640x360 的逻辑画布整数放大填满窗口。
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="Kanerjing"

[input]

send_message={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
