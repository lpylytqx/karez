# ============================================================
# 《坎儿井》AI 服务环境变量
# 用法：复制此文件为 .env，填入真实值。
# ⚠️ .env 已在 .gitignore 中，绝不要提交进任何代码库。
# ============================================================

# ---- 必填：DeepSeek API Key ----
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 模型选择 ----
# 2026-10-05 核查结论：当前可用模型 ID 只有以下两个。
#   deepseek-flash    → DeepSeek-V4.1-Flash  快、极便宜，用于日常对话/事件/批量短内容
#   deepseek-v4-pro   → DeepSeek-V4-Pro-0813 强，用于关键剧情/复杂博弈
# 已停用（勿用）：deepseek-chat、deepseek-reasoner（2026-07-24 下线）
# 兼容旧名（勿用）：deepseek-v4-flash、deepseek-v4-flash-vision-exp
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# Base URL。官方文档写 https://api.deepseek.com，未提及 /v1 后缀。
# strict 模式需要改成 https://api.deepseek.com/beta
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 思考模式 ----
# ⚠️ 官方默认 thinking.type = enabled，且默认 effort = high。
# 对游戏对话这是灾难：思考 token 计入 max_tokens，上限不足时表现为
# "HTTP 200 但 content 为空 / finish_reason=length"。
# 游戏对话必须关闭：快、便宜、输出可控。
# 可选值：disabled（推荐） / enabled
DEEPSEEK_THINKING=disabled

# ---- 输出控制 ----
# 非思考模式默认上限仅 8K，显式设定更稳。
# 注意：本项是"上限"，不是"目标长度"，设大不额外花钱。
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=1.0
DEEPSEEK_TIMEOUT=60

# ---- 服务 ----
AI_HOST=127.0.0.1
AI_PORT=8787

# ---- 降级 ----
# 无 Key / 无网络 / 连续失败时，自动返回预设内容，保证演示不冷场。
# 设为 1 可强制进入 demo 模式（用于测试演示容错）。
FORCE_DEMO=0

# ---- 日志 ----
# 是否记录每次调用的原始请求与响应（开发期建议 1，含成本统计）
LOG_AI_CALLS=1
LOG_DIR=logs
